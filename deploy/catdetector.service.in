# Template: install-service.sh fills in the user, the checkout path and the share's
# mount unit, then installs the result.
# Per-run settings (MOTION_THRESHOLD, METRICS_CSV, ...) go in a drop-in:
#   sudo systemctl edit catdetector
[Unit]
Description=Cat detector: litter-box camera, motion recorder and web UI
# Wants, not Requires: recording runs without the share. See docs/DESIGN.md, Running as a service.
Wants=@SHARE_MOUNT@
After=@SHARE_MOUNT@ time-sync.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@CHECKOUT@
# Waits up to 90 s for NTP, then starts anyway.
ExecStartPre=-/usr/bin/timeout 90 /usr/lib/systemd/systemd-time-wait-sync
ExecStart=@CHECKOUT@/.venv/bin/python main.py
Restart=on-failure
# Outlasts the camera's busy window after an unclean exit.
RestartSec=20
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
